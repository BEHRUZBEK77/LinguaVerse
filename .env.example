# ═══════════════════════════════════════════════════════════════════
# LinguaVerse — Environment Variables (NAMUNA)
#
# BU FAYLGA HAQIQIY KALIT YOZMANG — u GitHub'da ochiq turadi.
#
# Mahalliy sinov uchun:  .env  fayliga yozing (.gitignore da)
# Netlify uchun:  Site configuration → Environment variables
# ═══════════════════════════════════════════════════════════════════

# ── AI (netlify/functions/ai.js) ────────────────────────────────────
# DIQQAT: bu kalitlarni admin panel orqali ham saqlash mumkin
# (admin.html → "API Kalitlar"). O'shanda data/api-keys.json ga yoziladi.
#
# Groq — bepul, https://console.groq.com/keys
# Speaking (nutqni matnga) uchun ham ishlatiladi.
GROQ_API_KEY=gsk_sizning_kalitingiz

# Gemini — https://aistudio.google.com/apikey
# Bir nechta kalitni VERGUL bilan yozing: tizim navbat bilan ishlatadi,
# bittasining kunlik kvotasi tugasa keyingisiga o'tadi.
GEMINI_API_KEYS=AIza_kalit_1,AIza_kalit_2,AIza_kalit_3

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk_sizning_kalitingiz

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-sizning_kalitingiz

# Cloudflare Workers AI — https://dash.cloudflare.com/profile/api-tokens
# Token "Workers AI" (AI:Run) huquqiga ega bo'lishi kerak.
CLOUDFLARE_API_TOKEN=cloudflare_tokeni
CLOUDFLARE_ACCOUNT_ID=cloudflare_account_id

# Azure OpenAI (AI router uchun) — Azure Portal → Azure OpenAI
AZURE_OPENAI_KEY=azure_openai_kaliti
AZURE_OPENAI_RESOURCE=resurs_nomi
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── SPEAKING (netlify/functions/azure-speech.js) ────────────────────
# Azure Portal → Speech Service → Keys and Endpoint
# 13 tilda neural ovoz + talaffuz bahosi (o'zbekcha Madina/Sardor).
AZURE_SPEECH_KEY=azure_speech_kaliti
AZURE_SPEECH_REGION=eastus

# ── TO'LOV (netlify/functions/payment.js) ───────────────────────────
# inpay.uz merchant kabinetidan olinadi.
# INPAY_SANDBOX=1 bo'lsa haqiqiy pul o'tmaydi — oqimni sinash uchun.
# API auth (bearer) va webhook imzo secreti IKKI ALOHIDA kalit.
INPAY_SANDBOX=1
INPAY_API_URL=https://inpay.uz
INPAY_MERCHANT_ID=merchant_id
INPAY_BEARER_TOKEN=kassa_bearer_tokeni
INPAY_WEBHOOK_SECRET=webhook_imzo_secreti
# INPAY_SECRET_KEY=eski_bitta_kalit    # ikkalasi o'rniga ishlatiladi (eski loyihalar)

# ── FIREBASE ADMIN (to'lovdan keyin tarifni yoqish uchun) ───────────
# Firebase Console → Project settings → Service accounts
#   → "Generate new private key" → yuklangan JSON ichidan.
# DIQQAT: private key butun bazaga to'liq huquq beradi.
FIREBASE_PROJECT_ID=linguaverse-81b52
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@linguaverse-81b52.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── ESKI funksiyalar (zaxira sifatida qoladi) ───────────────────────
GOOGLE_TTS_KEYS=AIza_kalit_1,AIza_kalit_2


# ═══════════════════════════════════════════════════════════════════
# SOZLAGANDAN KEYIN TEKSHIRING (brauzerda oching):
#   /.netlify/functions/ai                     → provayderlar tayyormi
#   /.netlify/functions/azure-speech?test=1    → TTS va token ishlaydimi
#   /.netlify/functions/payment                → inpay sozlamalari
# ═══════════════════════════════════════════════════════════════════
